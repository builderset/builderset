<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Builderset.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="EFCore.NamingConventions" Version="9.0.0" />
    <PackageReference Include="JsonSchema.Net" Version="9.7.0" />
  </ItemGroup>

  <!--
    The kits' JSON Schemas, copied from the checker's npm install into the app at
    every build: the structure checked here and the rules the checker runs come
    from the same version of the kits. Point KitPackages elsewhere with
    -p:KitPackages=… when your checker lives somewhere else.
  -->
  <PropertyGroup>
    <KitPackages Condition="'$(KitPackages)' == ''">$(MSBuildProjectDirectory)/../checker/node_modules/@builderset/</KitPackages>
  </PropertyGroup>

  <ItemGroup>
    <Kit Include="email;article;form;card;popup" />
  </ItemGroup>

  <Target Name="CopyKitSchemas" BeforeTargets="AssignTargetPaths">
    <Error Condition="!Exists('$(KitPackages)%(Kit.Identity)/schema.json')"
           Text="No schema for the %(Kit.Identity) kit in $(KitPackages): run npm install in the checker first." />
    <ItemGroup>
      <Content Include="$(KitPackages)%(Kit.Identity)/schema.json"
               Link="schemas/%(Kit.Identity).schema.json"
               CopyToOutputDirectory="PreserveNewest"
               CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
