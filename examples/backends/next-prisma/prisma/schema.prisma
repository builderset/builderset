// The email templates, one row each. `prisma migrate dev` writes a migration
// from a change here; prisma/migrations holds the ones already written.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model EmailTemplate {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(120)
  // `draft` or `published`. Only a published template is sent.
  status        String    @default("draft")
  // The live document: what a recipient gets. Stored whole, exactly as the editor sent it.
  document      Json
  // The working copy; null when there are no unpublished changes.
  draftDocument Json?     @map("draft_document")
  // Changes on every write. The editor sends it back, and a different one
  // means someone else saved in between. Milliseconds, like a JavaScript Date.
  savedAt       DateTime  @map("saved_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("email_template")
}
