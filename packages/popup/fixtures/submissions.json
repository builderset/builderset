{
  "cases": [
    {
      "name": "everything right",
      "popup": "kitchen-sink",
      "values": {
        "plate": "AA 123 BC",
        "email": "ana@example.com",
        "phone": "+355 69 123 4567"
      },
      "expected": {
        "ok": true,
        "errors": {},
        "values": {
          "plate": "AA 123 BC",
          "email": "ana@example.com",
          "phone": "+355 69 123 4567"
        }
      }
    },
    {
      "name": "nothing sent: the required plate",
      "popup": "kitchen-sink",
      "values": {},
      "expected": {
        "ok": false,
        "errors": {
          "plate": {
            "code": "required"
          }
        },
        "values": {}
      }
    },
    {
      "name": "not an object of answers",
      "popup": "kitchen-sink",
      "values": [
        "AA 123 BC"
      ],
      "expected": {
        "ok": false,
        "errors": {
          "plate": {
            "code": "required"
          }
        },
        "values": {}
      }
    },
    {
      "name": "null",
      "popup": "kitchen-sink",
      "values": null,
      "expected": {
        "ok": false,
        "errors": {
          "plate": {
            "code": "required"
          }
        },
        "values": {}
      }
    },
    {
      "name": "blank strings are no answer",
      "popup": "kitchen-sink",
      "values": {
        "plate": "   ",
        "email": " ",
        "first_name": ""
      },
      "expected": {
        "ok": false,
        "errors": {
          "plate": {
            "code": "required"
          }
        },
        "values": {}
      }
    },
    {
      "name": "answers are trimmed; names the popup does not ask are dropped",
      "popup": "kitchen-sink",
      "values": {
        "plate": "  TR-482-KL ",
        "email": "ana@example.com",
        "phone": "+355 69 123 4567",
        "first_name": " Ana ",
        "utm_source": "mail"
      },
      "expected": {
        "ok": true,
        "errors": {},
        "values": {
          "plate": "TR-482-KL",
          "email": "ana@example.com",
          "phone": "+355 69 123 4567",
          "first_name": "Ana"
        }
      }
    },
    {
